# Terraform
terraform/.terraform/
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/terraform.tfstate.*.backup

# Independent Terraform roots (examples and lock files remain tracked)
environments/**/.terraform/
environments/**/terraform.tfstate*
environments/**/*.tfvars
!environments/**/*.tfvars.example
environments/**/*.tfplan

# Generated inventory exports (example remains tracked)
ansible/inventories/*.outputs.json
**/__pycache__/

# Packer output
packer/output-*/
packer/seed.iso

# VM artifacts (runtime, not source)
tmp/
vm-pool/
iso/
images/ubuntu-24.04-server-cloudimg-amd64.img
snapshots/

# OS artifacts
.DS_Store
*.swp
*.swo
*~

# Machine-local tool shims (symlinks into nvm; not portable)
bin/node
bin/npm
bin/npx

# Tool session artifacts
opencode-session.txt
*.opencode-session.txt
